@startuml
!include <C4/C4_Context>

title Контекстная диаграмма C4: Система открытия депозитов

Person(anonymous_client, "Новый клиент", "Потенциальный клиент, не прошедший идентификацию в банке")
Person(identified_client, "Идентифицированный клиент", "Клиент банка с доступом к интернет-банку")
Person(call_center_manager, "Менеджер кол-центра", "Сотрудник колл-центра, обрабатывающий заявки")
Person(back_office_worker, "Сотрудник бэк-офиса", "Сотрудник, подтверждающий заявки и открывающий депозиты")
Person(credit_specialist, "Сотрудник кредитования", "Сотрудник, обновляющий ставки по депозитам")

System(deposit_system, "Система открытия депозитов", "Предоставляет функционал для открытия депозитов через различные каналы")

System_Ext(abs, "АБС", "Автоматизированная банковская система")
System_Ext(sms_gateway, "SMS-шлюз", "Внешний сервис отправки SMS")

Rel(anonymous_client, deposit_system, "Просматривает депозиты и оставляет заявки через сайт")
Rel(identified_client, deposit_system, "Просматривает депозиты и открывает депозиты через интернет-банк")
Rel(call_center_manager, deposit_system, "Обрабатывает заявки и рассчитывает ставки")
Rel(back_office_worker, deposit_system, "Подтверждает заявки и открывает депозиты")
Rel(credit_specialist, abs, "Загружает XLS-файлы с обновленными ставками")
Rel(deposit_system, abs, "Получает актуальные ставки, отправляет команды на открытие депозитов")
Rel(deposit_system, sms_gateway, "Отправляет SMS-уведомления клиентам")

@enduml